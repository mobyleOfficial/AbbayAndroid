<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ cloud backup and device transfer: the library database and
     the settings; covers and other caches are rebuilt by a scan. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="Abbay" />
        <include domain="database" path="Abbay-wal" />
        <include domain="database" path="Abbay-shm" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="Abbay" />
        <include domain="database" path="Abbay-wal" />
        <include domain="database" path="Abbay-shm" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>

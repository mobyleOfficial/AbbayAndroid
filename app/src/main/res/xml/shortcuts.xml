<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher shortcuts. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_resume"
        android:shortcutId="resume_last_book"
        android:shortcutLongLabel="@string/shortcut_resume_long"
        android:shortcutShortLabel="@string/shortcut_resume_short">
        <intent
            android:action="com.mobyle.abbay.action.RESUME_LAST_BOOK"
            android:targetClass="com.mobyle.abbay.presentation.MainActivity"
            android:targetPackage="com.mobyle.abbay" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_sleep"
        android:shortcutId="start_sleep_timer"
        android:shortcutLongLabel="@string/shortcut_sleep_long"
        android:shortcutShortLabel="@string/shortcut_sleep_short">
        <intent
            android:action="com.mobyle.abbay.action.START_SLEEP_TIMER"
            android:targetClass="com.mobyle.abbay.presentation.MainActivity"
            android:targetPackage="com.mobyle.abbay" />
    </shortcut>
</shortcuts>
